0 0 0 rg
BT 1 0 0 1 6 652.4 Tm /F3 7.6 Tf 10 TL (#include <stdio.h>) Tj T* (#include <stdlib.h>) Tj T* (#include <string.h>) Tj T*  T* (#define MAX_ID 20) Tj T* (#define N 8) Tj T*  T* (struct Node {) Tj T* (    char id[MAX_ID];) Tj T* (    struct Node *left;) Tj T* (    struct Node *right;) Tj T* (};) Tj T*  T* (struct Node *createNode\(const char id[]\) {) Tj T* (    struct Node *newNode = \(struct Node *\)malloc\(sizeof\(struct Node\)\);) Tj T* (    strcpy\(newNode->id, id\);) Tj T* (    newNode->left = NULL;) Tj T* (    newNode->right = NULL;) Tj T* (    return newNode;) Tj T* (}) Tj T*  T* (struct Node *insert\(struct Node *root, const char id[]\) {) Tj T* (    if \(root == NULL\)) Tj T* (        return createNode\(id\);) Tj T*  T* (    if \(strcmp\(id, root->id\) < 0\)) Tj T* (        root->left = insert\(root->left, id\);) Tj T* (    else if \(strcmp\(id, root->id\) > 0\)) Tj T* (        root->right = insert\(root->right, id\);) Tj T*  T* (    return root;) Tj T* (}) Tj T*  T* (void inorder\(struct Node *root\) {) Tj T* (    if \(root != NULL\) {) Tj T* (        inorder\(root->left\);) Tj T* (        printf\("%s ", root->id\);) Tj T* (        inorder\(root->right\);) Tj T* (    }) Tj T* (}) Tj T*  T* (int bstSearch\(struct Node *root, const char key[]\) {) Tj T* (    int comparisons = 0;) Tj T*  T* (    while \(root != NULL\) {) Tj T* (        comparisons++;) Tj T*  T* (        if \(strcmp\(key, root->id\) == 0\)) Tj T* (            return comparisons;) Tj T*  T* (        if \(strcmp\(key, root->id\) < 0\)) Tj T* (            root = root->left;) Tj T* (        else) Tj T* (            root = root->right;) Tj T* (    }) Tj T*  T* (    return comparisons;) Tj T* (}) Tj T*  T* (int linearSearch\(const char ids[][MAX_ID], int n, const char key[]\) {) Tj T* (    int comparisons = 0;) Tj T*  T* (    for \(int i = 0; i < n; i++\) {) Tj T* (        comparisons++;) Tj T* (        if \(strcmp\(ids[i], key\) == 0\)) Tj T* (            return comparisons;) Tj T* ET
Q
 

endstream
